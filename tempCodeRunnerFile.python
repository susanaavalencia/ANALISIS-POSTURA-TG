# video_processor.py
import cv2
import os
import subprocess
import numpy as np
import pandas as pd
import mediapipe as mp

mp_pose = mp.solutions.pose
mp_drawing = mp.solutions.drawing_utils

def preprocess_frame(frame):
    """
    Aplica filtros de mejora (CLAHE, Sobel, Sharpen) al frame de entrada.
    """
    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    rgb = cv2.bilateralFilter(rgb, 7, 60, 60)

    # Ecualización CLAHE en el canal L
    lab = cv2.cvtColor(rgb, cv2.COLOR_RGB2LAB)
    l, a, b = cv2.split(lab)
    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
    l = clahe.apply(l)
    lab = cv2.merge([l, a, b])
    rgb = cv2.cvtColor(lab, cv2.COLOR_LAB2RGB)

    # Detección de bordes Sobel
    gray = cv2.cvtColor(rgb, cv2.COLOR_RGB2GRAY)
    sobelx = cv2.Sobel(gray, cv2.CV_64F, 1, 0, ksize=5)
    sobely = cv2.Sobel(gray, cv2.CV_64F, 0, 1, ksize=5)
    edges = cv2.magnitude(sobelx, sobely)
    edges = cv2.normalize(edges, None, 0, 255, cv2.NORM_MINMAX).astype("uint8")
    edges_color = cv2.cvtColor(edges, cv2.COLOR_GRAY2RGB)
    
    # Superposición de bordes
    rgb = cv2.addWeighted(rgb, 1.0, edges_color, 0.15, 0)

    # Filtro de enfoque (Sharpen)
    kernel_sharpen = np.array([
        [-1, -1, -1],
        [-1,  9, -1],
        [-1, -1, -1]
    ])
    rgb = cv2.filter2D(rgb, -1, kernel_sharpen)

    return rgb

def optimize_video_ffmpeg(input_path, output_path):
    """
    Comprime y estandariza el video a 30fps usando FFmpeg.
    Nota: Requiere tener FFmpeg instalado en las variables de entorno del sistema.
    """
    cmd_opt = [
        "ffmpeg", "-y", "-i", input_path,
        "-an", "-r", "30", "-b:v", "900k",
        "-c:v", "libx264", "-preset", "fast",
        output_path
    ]
    subprocess.run(cmd_opt, stdout=subprocess.DEVNULL, stderr=subprocess.STDOUT)
    return output_path

# video_processor.py
import cv2
import os
import subprocess
import numpy as np
import pandas as pd
import mediapipe as mp

# Inicialización compatible con MediaPipe 0.10.14
mp_pose = mp.solutions.pose
mp_drawing = mp.solutions.drawing_utils

def preprocess_frame(frame):
    """
    Aplica filtros de mejora (CLAHE, Sobel, Sharpen) al frame de entrada.
    """
    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    rgb = cv2.bilateralFilter(rgb, 7, 60, 60)

    lab = cv2.cvtColor(rgb, cv2.COLOR_RGB2LAB)
    l, a, b = cv2.split(lab)
    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
    l = clahe.apply(l)
    lab = cv2.merge([l, a, b])
    rgb = cv2.cvtColor(lab, cv2.COLOR_LAB2RGB)

    gray = cv2.cvtColor(rgb, cv2.COLOR_RGB2GRAY)
    sobelx = cv2.Sobel(gray, cv2.CV_64F, 1, 0, ksize=5)
    sobely = cv2.Sobel(gray, cv2.CV_64F, 0, 1, ksize=5)
    edges = cv2.magnitude(sobelx, sobely)
    edges = cv2.normalize(edges, None, 0, 255, cv2.NORM_MINMAX).astype("uint8")
    edges_color = cv2.cvtColor(edges, cv2.COLOR_GRAY2RGB)
    
    rgb = cv2.addWeighted(rgb, 1.0, edges_color, 0.15, 0)

    kernel_sharpen = np.array([
        [-1, -1, -1],
        [-1,  9, -1],
        [-1, -1, -1]
    ])
    rgb = cv2.filter2D(rgb, -1, kernel_sharpen)

    return rgb

def process_video_and_extract_csv(video_path, output_csv_path=None, generate_skeleton_video=False):
    """
    Procesa un video, aplica preprocesamiento, extrae landmarks con MediaPipe 0.10.14 
    y retorna el DataFrame y la ruta del video renderizado.
    """
    video_name = os.path.basename(video_path)
    cap = cv2.VideoCapture(video_path)
    
    fps = cap.get(cv2.CAP_PROP_FPS)
    w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    
    out_skeleton = None
    tmp_skeleton_path = None
    final_skeleton_path = None

    if generate_skeleton_video:
        tmp_skeleton_path = video_path.replace(".mp4", "_raw.mp4")
        final_skeleton_path = video_path.replace(".mp4", "_Postura.mp4")
        fourcc = cv2.VideoWriter_fourcc(*"mp4v")
        out_skeleton = cv2.VideoWriter(tmp_skeleton_path, fourcc, fps, (w, h))

    landmarks_data = []
    frame_idx = 0

    # Configuración estricta para la versión 0.10.x
    with mp_pose.Pose(
        static_image_mode=False,
        model_complexity=1,
        min_detection_confidence=0.5,
        min_tracking_confidence=0.5
    ) as pose:

        while True:
            ret, frame = cap.read()
            if not ret:
                break
            
            processed_frame = preprocess_frame(frame)
            results = pose.process(processed_frame)
            
            if generate_skeleton_video:
                black = np.zeros((h, w, 3), dtype=np.uint8)
                if results.pose_landmarks:
                    mp_drawing.draw_landmarks(black, results.pose_landmarks, mp_pose.POSE_CONNECTIONS)
                out_skeleton.write(black)
            
            if results.pose_landmarks:
                for landmark_id, landmark in enumerate(results.pose_landmarks.landmark):
                    landmarks_data.append({
                        "video": video_name,
                        "frame": frame_idx,
                        "landmark_id": landmark_id,
                        "x": landmark.x,
                        "y": landmark.y,
                        "z": landmark.z
                    })
            frame_idx += 1

    cap.release()
    if out_skeleton:
        out_skeleton.release()

    if generate_skeleton_video and tmp_skeleton_path:
        cmd_final = [
            "ffmpeg", "-y", "-i", tmp_skeleton_path,
            "-an", "-r", "30", "-b:v", "900k",
            "-c:v", "libx264", "-preset", "fast",
            final_skeleton_path
        ]
        subprocess.run(cmd_final, stdout=subprocess.DEVNULL, stderr=subprocess.STDOUT)
        os.remove(tmp_skeleton_path)

    df = pd.DataFrame(landmarks_data)
    if output_csv_path and not df.empty:
        df.to_csv(output_csv_path, index=False)
        
    return df, final_skeleton_path
